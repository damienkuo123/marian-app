{
  "schema": "TAPPIE-REWARD-DEFAULT-PRODUCTION-CONTRACT-V1.0",
  "contract": "TAPPIE-CHALLENGE-REWARD-DEFAULT-PRODUCTION-V1.0",
  "decision": "REWARD_IS_STANDARD_PLAYER_WIN_FLOW",
  "frontendRule": {
    "defaultEnabled": true,
    "requiredEnableQuery": null,
    "diagnosticOptOut": "rewardZone=0",
    "formalDirectUrl": "challenge.html?arena=football-field",
    "debugDirectUrl": "challenge.html?arena=football-field&arenaDebug=1"
  },
  "entryCondition": [
    "playerWon",
    "unityArena.isReady()",
    "final cue complete/reset"
  ],
  "state": "REWARD_GAMEPLAY",
  "ownershipLocks": [
    "ALPHA11_SINGLE_MOTOR",
    "no second CharacterController",
    "no reward camera owner",
    "no reward grounding owner"
  ],
  "mutationBoundary": [
    "dev/challenge.js",
    "dev/challenge.html cache-bust only"
  ],
  "forbidden": [
    "WebGL rebuild",
    "PC1 mutation",
    "PC2 mutation",
    "catalog topology mutation",
    "Source Scene mutation",
    "Git",
    "backend",
    "Supabase"
  ]
}
